generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREATOR
  REVIEWER
}

enum AssetStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum EventType {
  ASSET_CREATED
  ASSET_UPDATED
  DOCUMENT_UPLOADED
  STATUS_CHANGED
  DUPLICATE_FLAGGED
  DUPLICATE_REVIEWED
}

model User {
  user_id       String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(CREATOR)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  land_assets      LandAsset[]       @relation("CreatedAssets")
  uploaded_docs    Document[]        @relation("UploadedDocuments")
  workflow_actions WorkflowHistory[] @relation("ActionBy")
  reviewed_flags   DuplicateFlag[]   @relation("ReviewedBy")
  asset_events     AssetEvent[]      @relation("PerformedBy")
}

model LandAsset {
  asset_id    String      @id @default(uuid())
  land_id     String?
  survey_no   String?
  owner_name  String?
  area        Float?
  latitude    Float?
  longitude   Float?
  asset_type  String?
  description String?
  status      AssetStatus @default(DRAFT)
  created_by  String
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  // Relations
  creator         User              @relation("CreatedAssets", fields: [created_by], references: [user_id], onDelete: Restrict)
  documents       Document[]
  workflow        WorkflowHistory[]
  events          AssetEvent[]
  duplicate_flags DuplicateFlag[]   @relation("AssetFlags")
  matched_flags   DuplicateFlag[]   @relation("MatchedAssetFlags")

  @@index([survey_no])
  @@index([owner_name])
  @@index([created_by])
  @@index([status])
}

model Document {
  document_id   String   @id @default(uuid())
  asset_id      String
  file_name     String
  document_type String?
  storage_key   String
  mime_type     String?
  file_size     Int?
  uploaded_by   String
  uploaded_at   DateTime @default(now())

  // Relations
  asset    LandAsset @relation(fields: [asset_id], references: [asset_id], onDelete: Cascade)
  uploader User      @relation("UploadedDocuments", fields: [uploaded_by], references: [user_id], onDelete: Restrict)

  @@index([asset_id])
  @@index([uploaded_by])
}

model WorkflowHistory {
  history_id      String       @id @default(uuid())
  asset_id        String
  previous_status AssetStatus?
  new_status      AssetStatus
  action_by       String
  remarks         String?
  action_time     DateTime     @default(now())

  // Relations
  land_asset LandAsset @relation(fields: [asset_id], references: [asset_id], onDelete: Restrict)
  user       User      @relation("ActionBy", fields: [action_by], references: [user_id], onDelete: Restrict)

  @@index([asset_id])
  @@index([action_by])
}

model DuplicateFlag {
  flag_id             String       @id @default(uuid())
  asset_id            String
  matched_asset_id    String
  similarity_score    Float
  survey_similarity   Float?
  owner_similarity    Float?
  area_similarity     Float?
  location_similarity Float?
  reason              String?
  review_status       ReviewStatus @default(PENDING)
  reviewed_by         String?
  reviewed_at         DateTime?
  remarks             String?
  created_at          DateTime     @default(now())

  // Relations
  asset         LandAsset @relation("AssetFlags", fields: [asset_id], references: [asset_id], onDelete: Cascade)
  matched_asset LandAsset @relation("MatchedAssetFlags", fields: [matched_asset_id], references: [asset_id], onDelete: Cascade)
  reviewer      User?     @relation("ReviewedBy", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  @@index([asset_id])
  @@index([matched_asset_id])
  @@index([review_status])
}

model AssetEvent {
  event_id     String    @id @default(uuid())
  asset_id     String
  event_type   EventType
  performed_by String
  metadata     Json?
  created_at   DateTime  @default(now())

  // Relations
  asset LandAsset @relation(fields: [asset_id], references: [asset_id], onDelete: Restrict)
  user  User      @relation("PerformedBy", fields: [performed_by], references: [user_id], onDelete: Restrict)

  @@index([asset_id])
  @@index([performed_by])
}
